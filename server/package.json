{
  "name": "@lanesignal/server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "LANESIGNAL_DATA_DIR=.data LANESIGNAL_CONFIG=.data/lanesignal.json node --disable-warning=ExperimentalWarning --watch --experimental-strip-types src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "LOG_LEVEL=warn node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
