{
  "name": "LaneSignal",
  "publicUrl": "https://lanesignal.example.com",
  "groupLabel": "Group",
  "ticketTemplates": {
    "redmine": "https://redmine.example.com/issues/{id}",
    "gh": "https://github.com/example/app/issues/{id}",
    "jira": "https://example.atlassian.net/browse/{id}"
  },
  "defaultTicketSystem": "redmine",
  "staleMinutes": 30,
  "notifyOn": [
    "escalation",
    "notice"
  ],
  "fcmServiceAccountFile": "/config/fcm-service-account.json"
}
