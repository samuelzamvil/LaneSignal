# Copy to .env. Every setting can also live in config/lanesignal.json; env vars win.
LANESIGNAL_PORT=8080
# Accounts: on first start, open the web UI and create the admin account; agent keys are made in Settings.
# Optional static tokens for automation / break-glass (name:token pairs, tokens >= 16 chars):
# LANESIGNAL_HUMAN_TOKENS=ops:change-me-to-a-long-random-token
# LANESIGNAL_AGENT_TOKENS=ci-bot:change-me-to-another-long-random-token
# LANESIGNAL_AUTH_SECRET=   # >= 32 chars; generated into the data volume when unset
# What a group of lanes (one overseer session's epic/train) is called in the UI
LANESIGNAL_GROUP_LABEL=Epic
LANESIGNAL_TICKET_TEMPLATES=redmine=https://redmine.example.com/issues/{id},gh=https://github.com/example/app/issues/{id}
LANESIGNAL_TICKET_DEFAULT=redmine
LANESIGNAL_PUBLIC_URL=https://lanesignal.example.com
# Push: escalation (default), blocked, completed
LANESIGNAL_NOTIFY_ON=escalation
# LANESIGNAL_FCM_SERVICE_ACCOUNT_FILE=/config/fcm-service-account.json
# LANESIGNAL_NTFY_URL=https://ntfy.sh/your-secret-topic
