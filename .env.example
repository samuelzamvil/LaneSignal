# Copy to .env. Most settings can also live in config/lanesignal.json; env vars win.
# Full reference: docs/configuration.md
LANESIGNAL_PORT=8080
# This compose file binds to 127.0.0.1 for a reverse proxy on the host; 1 = trust that one proxy.
# Use false if you remove the proxy. See docs/reverse-proxy.md.
LANESIGNAL_TRUST_PROXY=1
# Accounts: on first start, open the web UI and create the admin account; agent keys are made in Settings.
# Optional static tokens for automation / break-glass (name:token pairs, tokens >= 16 chars):
# LANESIGNAL_HUMAN_TOKENS=ops:change-me-to-a-long-random-token
# LANESIGNAL_AGENT_TOKENS=ci-bot:change-me-to-another-long-random-token
# LANESIGNAL_AUTH_SECRET=   # >= 32 chars; generated into the data volume when unset
# Sign-in through Cloudflare Access (beta, off by default). People Access lets in are signed in as the
# LaneSignal account with their email; the Android app signs in through Access's Managed OAuth.
# See docs/cloudflare-access.md for the Cloudflare side.
# LANESIGNAL_CLOUDFLARE_ACCESS=true
# LANESIGNAL_CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# LANESIGNAL_CF_ACCESS_AUD=<the Access application's Application Audience (AUD) tag>
# Give emails Access lets in an account (not an admin) on first sign-in, instead of refusing them:
# LANESIGNAL_CF_ACCESS_CREATE_ACCOUNTS=false
# The Android app's signing-certificate SHA-256, so the sign-in callback opens the app directly (App Link):
# LANESIGNAL_ANDROID_CERT_SHA256=AB:CD:...
# What a group of lanes (one overseer session's epic/train) is called in the UI
LANESIGNAL_GROUP_LABEL=Epic
LANESIGNAL_TICKET_TEMPLATES=redmine=https://redmine.example.com/issues/{id},gh=https://github.com/example/app/issues/{id}
LANESIGNAL_TICKET_DEFAULT=redmine
LANESIGNAL_PUBLIC_URL=https://lanesignal.example.com
# Push: escalation (default), blocked, completed
LANESIGNAL_NOTIFY_ON=escalation
# LANESIGNAL_FCM_SERVICE_ACCOUNT_FILE=/config/fcm-service-account.json
# LANESIGNAL_NTFY_URL=https://ntfy.sh/your-secret-topic
