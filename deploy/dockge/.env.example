# ---- LaneSignal (paste into Dockge's .env editor) ----

# Host port (the container always listens on 8080)
LANESIGNAL_PORT=8080

# The URL people and phones use to reach LaneSignal. Used for notification
# links and as the trusted origin for sign-in. Use HTTPS outside your LAN.
LANESIGNAL_PUBLIC_URL=https://lanesignal.example.com

# How far to trust X-Forwarded-For when working out a client's IP (sign-in rate limit).
# Keep "false" while clients can reach the published port directly (the default stack).
# Set 1 only when ONE reverse proxy is the sole way in: the stack joins the proxy's
# network with no `ports:`, or the port is bound to 127.0.0.1 for a proxy on the host.
# Never "true". See docs/reverse-proxy.md.
LANESIGNAL_TRUST_PROXY=false

# Features. By default you answer escalations on the dashboard and phone app, and
# agents wait for the decision. false makes LaneSignal alerts only: you answer in the
# agent's session and the agent dismisses the alert. See docs/configuration.md.
# LANESIGNAL_DECISIONS=true
# The requirements register (a durable record of your decisions agents can query).
# LANESIGNAL_REQUIREMENTS=true

# What a group of lanes (one overseer session's work) is called in the app
# LANESIGNAL_GROUP_LABEL=Group

# Clickable ticket references: key=url with {id}; refs look like redmine:1234 or gh:42
LANESIGNAL_TICKET_TEMPLATES=redmine=https://redmine.example.com/issues/{id},gh=https://github.com/example/app/issues/{id}
LANESIGNAL_TICKET_DEFAULT=redmine

# Push for new escalations without Google: subscribe to this topic in the ntfy app
# LANESIGNAL_NTFY_URL=https://ntfy.sh/pick-a-long-random-topic-name
# LANESIGNAL_NTFY_TOKEN=
# Tapping a notification opens the LaneSignal Android app; "browser" opens the web app instead.
# LANESIGNAL_NTFY_OPEN=app

# Optional break-glass / automation tokens (name:token, 16+ chars each).
# Accounts and agent keys from the web UI are the normal way in.
# LANESIGNAL_HUMAN_TOKENS=ops:replace-with-openssl-rand-base64-24
# LANESIGNAL_AGENT_TOKENS=ci-bot:replace-with-openssl-rand-base64-24

# Sign-in attempts per client IP per window (seconds)
# LANESIGNAL_SIGNIN_RATE_MAX=5
# LANESIGNAL_SIGNIN_RATE_WINDOW=60

LOG_LEVEL=info
